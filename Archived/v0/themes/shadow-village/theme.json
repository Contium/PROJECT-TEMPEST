{
  "id": "shadow-village",
  "extends": "moontown",
  "name": "Moontown · Shadow Village",
  "version": "0.1.0",
  "description": "The obsidian side of the storybook: night-dark pages, parchment ink, mauve frames and violet arcane glows. Same shapes and type as Moontown.",
  "inspiration": [
    "MOONTOWN: Shadow Village / The Obsidian Shaman key art (Zeren Dovey)"
  ],
  "stylesheet": "theme.css",
