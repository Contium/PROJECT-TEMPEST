<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0D0F14</color>
    <color name="surface">#161A22</color>
    <color name="text">#E8E6E3</color>
    <color name="muted">#9AA0AA</color>
    <color name="accent">#F75049</color>

    <style name="Theme.Tempest" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="Theme.Tempest.Screen">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
