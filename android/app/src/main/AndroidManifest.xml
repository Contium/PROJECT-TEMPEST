<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+: reaching devices on the home network (the GM's PC) needs the user's say-so.
         Without it, every request to TEMPEST is silently blocked. Asked for in ScreenActivity. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Tempest"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true">

        <!-- Setup: scan the GM's QR code, paste the link, or reconnect to the last table. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- TEMPEST's links from the camera app or a chat can open here: the GM window's
                 (http://<GM's PC>:<port>/gm?k=…) and the player screen's (…/join?k=…). Any host:
                 the GM's PC is on the local network, its address unknown. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="*" android:path="/join" />
                <data android:path="/gm" />
            </intent-filter>
        </activity>

        <!-- The player screen itself: full screen, kept awake. -->
        <activity
            android:name=".ScreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.Tempest.Screen" />
    </application>
</manifest>
