  "values": {
    "category": "rumor",
    "name": "Ghosts in the Freight Yard",
    "start": {
      "y": 2045,
      "m": 11,
      "d": 3
    },
    "summary": "Dockworkers swear something walks between the reefer containers at night, and the night shift keeps quitting.",
    "f_bf5aae98": {
      "id": "story_dfc2b605"
    },
    "f_5614b4d0": "Ask around the Port and every dockworker has a version: lights in the cold containers, voices through the steel, a guard who walked in and never clocked out. Nobody will take the night shift at Yard 9 anymore.",
    "f_01a830e7": {
      "text": "The docks at the Port of Night City"
    },
    "f_69f9405f": {
      "people": [
        {
          "id": "char_a14f1dad",
          "note": "Quietly paying people to keep the rumor going"
        }
      ]
    },
    "f_18599300": {
      "value": 0
    },
    "f_1b88e90a": "The \"ghosts\" are a corp team running night tests on the containers.",
    "f_ebdb6fa6": "This is the hook for Cold Storage: whoever chases it ends up at Ledger's booth."
  },
