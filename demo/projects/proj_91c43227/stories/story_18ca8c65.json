    "summary": "The Chrome Vultures go to war over Santo Domingo's salvage yards.",
    "f_5614b4d0": "Not a job, a hazard: anyone crossing Santo Domingo this week does it under fire.",
    "f_01a830e7": {
      "text": "Santo Domingo, mostly around the old salvage yards"
    },
    "f_69f9405f": {
      "people": [
        {
          "id": "char_5a7754ea",
          "note": "Leading the Vultures"
        },
        {
          "id": "char_b91339e6",
          "note": "NCPD task force, waiting for both sides to bleed"
        }
      ]
    },
    "f_18599300": {
      "value": 0
    },
    "f_1b88e90a": "Roadblocks on every main street. Vultures stripping cars, and drivers, for parts.",
    "f_ebdb6fa6": "Halcyon is paying both sides through Doc Haas, so the \"salvage\" keeps flowing."
  },
