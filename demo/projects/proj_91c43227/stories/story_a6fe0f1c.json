  "values": {
    "category": "event",
    "image": "img_027cdd5a99c88b7db38afdd8",
    "name": "Kabuki Night Market Blackout",
    "start": {
      "y": 2045,
      "m": 11,
      "d": 5,
      "time": "21:30"
    },
    "end": {
      "y": 2045,
      "m": 11,
      "d": 5,
      "time": "23:00"
    },
    "summary": "The grid drops across Kabuki for ninety minutes, and the night market turns into a free-for-all.",
    "f_bf5aae98": {
      "id": "story_dfc2b605"
    },
    "f_5614b4d0": "Every stall goes dark at once. Vendors with generators become kings, looters work the edges, and the Tyger Claws move in to \"keep order\" for a fee.",
    "f_01a830e7": {
      "text": "Kabuki night market, Watson"
    },
    "f_69f9405f": {
      "people": [
        {
          "id": "char_a14f1dad",
          "note": "His noodle bar is one of the few places with lights on"
        },
        {
          "id": "char_65cc6cbc",
          "note": "Seen running through the market with someone's cyberarm"
        }
      ]
    },
    "f_18599300": {
      "value": 0
    },
    "f_1b88e90a": "A MAX-TAC AV circles overhead for the whole blackout but never lands.",
    "f_ebdb6fa6": "The blackout was a cover for a data heist on a substation; Lt. Reyes's team was there to watch, not help."
  },
