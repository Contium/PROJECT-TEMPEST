    "end": {
      "y": 2045,
      "m": 3,
      "d": 11
    },
    "summary": "A Halcyon Biotics researcher wants out. Mama Ndiaye has a crew for that.",
    "f_bf5aae98": {
      "id": "story_0ea5e98f"
    },
    "f_5614b4d0": "Get Dr. Imani Hale out of Halcyon's Exec Zone lab during the shift change and hand her to Mama Ndiaye. No bodies: Halcyon pays the NCPD well.",
    "f_01a830e7": {
      "text": "Halcyon Biotics research tower, Exec Zone; the service tunnels under it"
    },
    "f_69f9405f": {
      "people": [
        {
          "id": "char_652e9dae",
          "note": "Fixer: set up the job"
        },
        {
          "id": "char_5b413680",
          "note": "Secretly hired the crew through a cut-out"
        },
        {
          "id": "char_3de62be7",
          "note": "Has to open the tunnel doors from the NET"
        }
      ]
    },
    "f_18599300": {
      "value": 6000
    },
    "f_1b88e90a": "The tunnels come out next to Doc Haas's clinic. Chrome Vultures guard it at night.",
    "f_ebdb6fa6": "Ward wants Hale to escape, to see where she runs. Every step is being watched."
  },
